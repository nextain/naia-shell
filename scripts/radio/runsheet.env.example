# Naia radio 30-minute runsheet runner settings.
# Copy to runsheet.env, fill in, then: set -a; . ./runsheet.env; set +a; python3 scripts/radio/run-30m-runsheet.py
# The runner checks every path below before it starts and exits 2 listing what is missing.

# Required. Radio work folder on the broadcast machine (holds wk.mjs, jun-send-nz.sh, bgm, recordings).
RADIO_BASE_DIR=

# Optional. Node executable used to run wk.mjs (name on PATH or absolute path).
RADIO_NODE=node

# Optional. WebKit eval helper. Default: $RADIO_BASE_DIR/wk.mjs
RADIO_WK_SCRIPT=

# Optional. Chat send script (must be executable). Default: $RADIO_BASE_DIR/jun-send-nz.sh
RADIO_SEND_SCRIPT=

# Optional. Folder holding the four show songs. Default: the bgm-musics folder under naia-settings in RADIO_BASE_DIR
RADIO_BGM_DIR=

# Optional. Recordings and runsheet logs. Default: $RADIO_BASE_DIR/rtmp/recordings
RADIO_OUT_DIR=

# Optional. Pre-rendered show-voice audio for the fallback lines (one file per line, names in
# FALLBACK_AUDIO_FILES of run-30m-runsheet.py). Played when a turn fails. Default: $RADIO_BASE_DIR/fallback-audio
RADIO_FALLBACK_AUDIO_DIR=

# Optional. User id whose PulseAudio socket ffmpeg plays into. Default: current user.
RADIO_PULSE_UID=

# Optional. Tag used in log, training, and summary JSON file names.
RADIO_SHOW_TAG=show2-20261109

# Optional. Runsheet version:
# - v1 (default): Show 2 21-cue + 5-song clock-timed schedule
# - v2: 2026-11-14 30-slot sequential talk schedule (no 5s post-speech delay, rotating follow-ups)
RADIO_RUNSHEET_MODE=v1

# Optional. Music mode:
# - full (default for v1): checks and plays all four SONG_FILES
# - none (default for v2): talk-only rehearsal (BGM muted, SONG_FILES skipped in preflight)
# - internal-ko-en: plays only the two Nextain original tracks (ko at 05:00, en at 12:00)
RADIO_MUSIC_MODE=

# Optional. In v2 mode, keep a single continuous chat session by default (0); set 1 for 3-turn sliding reset.
RADIO_V2_SLIDING_NEW_CHAT=0

# Optional. Broadcast start (unix seconds). Default: now.
RADIO_START_TS=
