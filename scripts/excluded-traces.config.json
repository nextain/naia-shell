        "packages/shell/src/lib/voice/azure-voice-live.ts",
        "packages/shell/src/lib/voice/naia-omni.ts",
        "packages/shell/src/lib/voice/vllm-omni.ts"
      ],
      "mustExist": [
        "packages/shell/src/lib/llm/main-role.ts",
        "packages/shell/src/lib/llm/openai-base-url.ts",
        "packages/shell/src/lib/voice/azure-voice-live.ts",
        "packages/shell/src/lib/voice/naia-omni.ts",
        "packages/shell/src/lib/tts/edge-tts.ts",
        "packages/shell/src/lib/stt/web-speech-stt.ts"
      ]
    },
    "agent": {
      "include": ["src/**", "scripts/**", "docs/**", ".agents/context/**", "package.json"],
      "exclude": ["**/node_modules/**", "docs/progress/**", ".agents/context/process-status.json"],
      "keepRoots": [
        "src/main/adapters/claude-code-provider.ts",
        "src/main/adapters/codex-app-server-provider.ts",
        "src/main/adapters/grok-cli-provider.ts",
        "src/main/adapters/openai-compat-provider.ts",
        "src/main/adapters/ollama-provider.ts",
        "src/main/domain/llm-role-selection.ts"
      ],
      "mustExist": [
        "src/main/adapters/claude-code-provider.ts",
        "src/main/adapters/codex-app-server-provider.ts",
        "src/main/adapters/grok-cli-provider.ts",
        "src/main/adapters/openai-compat-provider.ts",
        "src/main/adapters/ollama-provider.ts",
        "src/main/domain/llm-role-selection.ts"
      ]
    }
  }
}
