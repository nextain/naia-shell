+    background: var(--bg-surface); color: var(--text-primary); font: inherit;
+    box-shadow: 0 20px 70px #0008; line-height: 1.5;
+}
+.browser-memory-dialog::backdrop { background: #0009; }
+.browser-memory-dialog h3 { font-size: 18px; }
+.browser-memory-dialog summary { cursor: pointer; padding: 8px 0; }
+.browser-memory-dialog li { margin: 4px 0 4px 18px; }
+.browser-memory button { padding: 9px 14px; min-height: 40px; border-radius: 8px; border: 1px solid var(--border-color); background: var(--accent); color: var(--bg-base); font: inherit; cursor: pointer; }
+.browser-memory button.btn-secondary { background: var(--bg-surface-2); color: var(--text-primary); }
+.browser-memory button:disabled { opacity: .55; cursor: wait; }
+.browser-memory [role="alert"] { color: var(--error); }
+.browser-memory :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
