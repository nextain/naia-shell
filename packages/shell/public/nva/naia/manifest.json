{
  "nva_version": "0.2",
  "meta": {
    "name": "나이아",
    "id": "naia",
    "version": "0.2.0",
    "description": "나이아 기본 비디오 아바타 (2D 셀 애니)",
    "style_label": "2D 셀 애니",
    "author": "Nextain",
    "license": "Proprietary"
  },
  "canvas": {
    "width": 720,
    "height": 1280,
    "fps": 24,
    "face_bbox": [
      0.26,
      0.16,
      0.48,
      0.22
    ]
  },
  "background": {
    "type": "transparent"
  },
  "poses": [
    "default"
  ],
  "animations": {
    "idle": {
      "loop": true,
      "can_talk": false,
      "entry_pose": "default",
      "exit_pose": "default",
      "label": "대기",
      "clip": "clips/idle.webm"
    },
    "talking": {
      "loop": true,
      "can_talk": true,
      "entry_pose": "default",
      "exit_pose": "default",
      "label": "말하기",
      "clip": "clips/talking-ko.webm"
    },
    "greeting": {
      "loop": false,
      "can_talk": false,
      "label": "인사",
      "clip": "clips/greeting.webm"
    },
    "happy": {
      "loop": false,
      "can_talk": false,
      "label": "기쁨",
      "clip": "clips/happy.webm"
    },
    "keyboard-idle": {
      "loop": false,
      "can_talk": false,
      "label": "건반 치며 대기",
      "clip": "clips/keyboard-idle.webm"
    },
    "singing-keyboard": {
      "loop": false,
      "can_talk": false,
      "label": "건반 치며 노래",
      "clip": "clips/singing-keyboard.webm"
    }
  },
  "speech_clips": {
    "speech-ko": {
      "locale": "ko",
      "text": "안녕하세요. 오늘은 미리 생성한 발화 자산을 자연스럽게 연결해서, 그래픽 카드가 없는 컴퓨터에서도 비디오 아바타가 긴 문장을 안정적으로 말할 수 있는지 확인하겠습니다. 모음과 자음이 빠르게 바뀌는 구간, 잠시 숨을 고르는 구간, 그리고 문장이 길게 이어지는 구간까지 차례로 살펴보겠습니다.",
      "clip": "clips/talking-ko.webm"
    }
  },
  "expressions": {
    "neutral": "idle",
    "talking": "talking",
    "greeting": "greeting",
    "happy": "happy",
    "keyboard-idle": "keyboard-idle",
    "singing-keyboard": "singing-keyboard"
  },
  "scenario": {
    "nodes": {
      "start": {
        "type": "start"
      },
      "idle": {
        "type": "scene",
        "animation": "idle"
      }
    },
    "edges": [
      {
        "from": "start",
        "to": "idle"
      }
    ]
  },
  "stacked_alpha": {
    "layout": "color-top-alpha-bottom",
    "clips": {
      "clips/greeting.webm": "clips/greeting.stacked.mp4",
      "clips/happy.webm": "clips/happy.stacked.mp4",
      "clips/idle.webm": "clips/idle.stacked.mp4",
      "clips/keyboard-idle.webm": "clips/keyboard-idle.stacked.mp4",
      "clips/singing-keyboard.webm": "clips/singing-keyboard.stacked.mp4",
      "clips/talking-ko.webm": "clips/talking-ko.stacked.mp4"
    }
  }
}
