AppEvents
| where TimeGenerated between (datetime(2026-11-18T17:12:50Z) .. datetime(2026-11-18T17:20:00Z))
| where tostring(Properties.installation_id) == "0ff0668d-ff22-4fdf-ad35-a35f808ba254"
| project occurred_at=TimeGenerated, name=Name, event_id=tostring(Properties.event_id), installation_id=tostring(Properties.installation_id), sequence=toint(Properties.sequence), screen=tostring(Properties.screen)
| order by occurred_at asc
