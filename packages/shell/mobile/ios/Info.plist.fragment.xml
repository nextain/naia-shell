<?xml version="1.0" encoding="UTF-8"?>
<!--
  Merge the following keys into `ios/App/App/Info.plist` after running `npx cap add ios`.
  Required for:
    1. Voice conversation microphone capture (`NSMicrophoneUsageDescription`)
    2. Speech recognition (`NSSpeechRecognitionUsageDescription`)
    3. Background voice call / Naia Radio playback + APNs push (`UIBackgroundModes`)
    4. `naia://` custom URL deep links (`CFBundleURLTypes`)
-->
<plist version="1.0">
<dict>
	<key>NSMicrophoneUsageDescription</key>
	<string>나이아와 실시간 음성 대화를 나누기 위해 마이크 권한이 필요합니다.</string>

	<key>NSSpeechRecognitionUsageDescription</key>
	<string>음성 명령 및 대화를 텍스트로 변환하기 위해 음성 인식 권한이 필요합니다.</string>

	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>remote-notification</string>
	</array>

	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>land.naia.mobile</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>naia</string>
			</array>
		</dict>
	</array>

	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
