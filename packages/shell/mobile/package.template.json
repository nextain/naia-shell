{
	"name": "@nextain/naia-mobile-capacitor",
	"version": "0.2.6",
	"private": true,
	"type": "module",
	"description": "Capacitor 7 iOS/Android native wrapper scaffold for naia-shell Web Mode",
	"scripts": {
		"build:web": "pnpm --dir .. exec vite build --mode web",
		"cap:sync": "pnpm run build:web && cap sync",
		"cap:add:ios": "cap add ios",
		"cap:add:android": "cap add android",
		"cap:open:ios": "cap open ios",
		"cap:open:android": "cap open android"
	},
	"dependencies": {
		"@capacitor/android": "^7.1.0",
		"@capacitor/app": "^7.0.0",
		"@capacitor/core": "^7.1.0",
		"@capacitor/ios": "^7.1.0",
		"@capacitor/keyboard": "^7.0.0",
		"@capacitor/push-notifications": "^7.0.0",
		"@capacitor/splash-screen": "^7.0.0",
		"@capacitor/status-bar": "^7.0.0",
		"@capgo/native-purchases": "^7.2.0"
	},
	"devDependencies": {
		"@capacitor/cli": "^7.1.0",
		"typescript": "^5.6.0"
	}
}
